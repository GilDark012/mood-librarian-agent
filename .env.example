# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required: Groq LLM key (https://console.groq.com/keys) ---
GROQ_API_KEY="your_groq_api_key_here"

# --- Optional LLM settings ---
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# --- API access control ---
# If set, callers must send this value in the `X-API-Key` header.
# Leave empty ONLY for local/demo use. Set a strong value before going online.
API_KEY=""
# Comma-separated allowed CORS origins, or "*" for any.
ALLOWED_ORIGINS="*"
# Rate limit per client IP for /recommend.
RATE_LIMIT="10/minute"

# --- Request limits ---
MAX_MOOD_LENGTH=500
REQUEST_TIMEOUT=30
MAX_AGENT_STEPS=5
