# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required: Groq LLM key (https://console.groq.com/keys) ---
GROQ_API_KEY="your_groq_api_key_here"

# --- Optional LLM settings ---
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# --- API access control ---
# If set, callers must send this value in the `X-API-Key` header.
# Leave empty ONLY for local/demo use. Set a strong value before going online.
API_KEY=""
# Comma-separated allowed CORS origins, or "*" for any.
ALLOWED_ORIGINS="*"
# Per-IP rate limits for the agent endpoints.
RATE_LIMIT="10/minute"
RATE_LIMIT_DAILY="200/day"

# --- Request limits ---
MAX_MOOD_LENGTH=500
REQUEST_TIMEOUT=30
MAX_AGENT_STEPS=3

# --- Statistics (GET /stats) ---
# If set, /stats requires this value in the `X-Stats-Token` header (else 404).
STATS_TOKEN=""
# Optional: durable counters via Upstash Redis REST (https://upstash.com).
# Without these, stats are in-memory and reset when the instance restarts.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Rough Groq price per 1M tokens, for the /stats cost estimate.
COST_PER_MTOKEN_USD=0.30
